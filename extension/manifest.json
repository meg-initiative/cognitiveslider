{
  "manifest_version": 3,
  "name": "CognitiveSlider",
  "version": "1.2.0",
  "version_name": "1.2.0 technical preview",
  "description": "Choose your participation level in AI conversations. Adds the MCS protocol to text messages.",
  "homepage_url": "https://cognitiveslider.org/",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "protocol.js",
        "core.js",
        "conversation.js",
        "adapters.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
